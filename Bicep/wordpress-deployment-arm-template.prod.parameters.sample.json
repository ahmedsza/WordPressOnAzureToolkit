    "vnetAddressSpace": { "value": "10.0.0.0/23" },
    "appSubnetAddressPrefix": { "value": "10.0.0.0/25" },
    "databaseSubnetAddressPrefix": { "value": "10.0.1.0/25" },
    "privateEndpointSubnetAddressPrefix": { "value": "10.0.0.128/26" },
    "blobSoftDeleteRetentionDays": { "value": 30 },
    "containerSoftDeleteRetentionDays": { "value": 30 },
    "frontDoorHealthProbePath": { "value": "/" },
    "frontDoorHealthProbeIntervalInSeconds": { "value": 30 },
    "frontDoorWafMode": { "value": "Prevention" }
