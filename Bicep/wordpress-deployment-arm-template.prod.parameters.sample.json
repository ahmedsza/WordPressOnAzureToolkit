{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "name": { "value": "wordpress-example" },
    "environmentName": { "value": "prod" },
    "location": { "value": "southafricanorth" },
    "emailDataLocation": { "value": "africa" },
    "appServiceZoneRedundant": { "value": true },
    "wordpressAdminEmail": { "value": "wordpress-admin@example.com" },
    "serverUsername": { "value": "wpdbadmin" },
    "serverPassword": { "value": "<set-a-strong-mysql-password>" },
    "wordpressUsername": { "value": "wpadmin" },
    "wordpressPassword": { "value": "<set-a-strong-wordpress-password>" },
    "wpLocaleCode": { "value": "en_US" },
    "kind": { "value": "linux" },
    "reserved": { "value": true },
    "alwaysOn": { "value": true },
    "ftpsState": { "value": "FtpsOnly" },
    "linuxFxVersion": { "value": "sitecontainers" },
    "siteContainerName": { "value": "main" },
    "siteContainerImage": { "value": "mcr.microsoft.com/appsvc/wordpress-debian-php:8.4" },
    "appServicePlanSkuName": { "value": "P1V3" },
    "appServicePlanSkuTier": { "value": "PremiumV3" },
    "appServicePlanCapacity": { "value": 3 },
    "mysqlHighAvailabilityMode": { "value": "ZoneRedundant" },
    "mysqlSkuName": { "value": "Standard_D2ds_v4" },
    "mysqlSkuTier": { "value": "GeneralPurpose" },
    "storageSizeGB": { "value": 128 },
    "storageIops": { "value": 700 },
    "storageAutoGrow": { "value": "Enabled" },
    "storageAutoIoScaling": { "value": "Enabled" },
    "publicNetworkAccess": { "value": "Disabled" },
    "charset": { "value": "utf8" },
    "collation": { "value": "utf8_general_ci" },
    "storageAccountType": { "value": "Standard_RAGRS" },
    "storageAccountKind": { "value": "StorageV2" },
    "accessTier": { "value": "Hot" },
    "minimumTlsVersion": { "value": "TLS1_2" },
    "supportsHttpsTrafficOnly": { "value": true },
    "keySource": { "value": "Microsoft.Storage" },
    "encryptionEnabled": { "value": true },
    "infrastructureEncryptionEnabled": { "value": false },
    "backupRetentionDays": { "value": 35 },
